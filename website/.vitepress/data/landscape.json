      "landing": true,
      "title": { "en": "Model-accurate token counts", "tr": "Modele göre birebir token sayımı" },
      "body": {
        "en": "The right encoding for each model family, exact counts in the default install, and Claude counts through the API on request.",
        "tr": "Her model ailesi için doğru kodlama, varsayılan kurulumda birebir sayım ve istenirse Claude için API ile sayım."
      }
    },
    {
      "id": "P3",
      "landing": true,
      "title": { "en": "`--budget` with content", "tr": "İçerikli `--budget`" },
      "body": {
        "en": "Pack the highest-ranked files and methods into a token budget from the CLI, and export their content as Claude-ready XML.",
        "tr": "En üst sıradaki dosya ve metotları CLI'den bir token bütçesine sığdırın ve içeriklerini Claude'a hazır XML olarak dışa aktarın."
      }
    },
