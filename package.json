{
  "name": "ctxman",
  "version": "3.0.0",
  "description": "AI Development Platform with plugin architecture, Git integration, REST API, watch mode, LLM optimization, and support for 14+ languages. Features include TOON format (40-50% token reduction), real-time analysis, and comprehensive context generation.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "ctxman": "bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf coverage test-results",
    "analyze": "node bin/cli.js",
    "analyze:cli": "node bin/cli.js --cli",
    "analyze:methods": "node bin/cli.js --cli --method-level",
    "analyze:gitingest": "node bin/cli.js --cli --gitingest",
    "serve": "node bin/cli.js serve",
    "watch": "node bin/cli.js watch",
    "github": "node bin/cm-gitingest.js",
    "install:local": "bash scripts/install.sh",
    "uninstall:local": "bash scripts/uninstall.sh",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:windows": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "update:check": "node bin/cm-update.js check",
    "update:install": "node bin/cm-update.js install",
    "update:rollback": "node bin/cm-update.js rollback",
    "update:channel": "node bin/cm-update.js channel",
    "build": "echo 'No build step required'",
    "build:deb": "make build-deb",
    "prepublishOnly": "npm test",
    "prepack": "npm run clean && npm test",
    "prepare": "husky || true",
    "mcp": "node bin/mcp-server.js",
    "postinstall": "node -e \"console.log('\\n✅ Ctxman installed! Run: ctxman --help\\n')\"",
    "docs:dev": "npm run docs:dev --prefix website",
    "docs:build": "npm run docs:build --prefix website",
    "docs:preview": "npm run docs:preview --prefix website"
  },
  "keywords": [
    "code",
    "analysis",
    "llm",
    "context",
    "plugin-system",
    "git-integration",
    "api-server",
    "watch-mode",
    "method-level",
    "javascript",
    "typescript",
    "rust",
    "csharp",
    "go",
    "java",
    "python",
    "php",
    "ruby",
    "kotlin",
    "swift",
    "cpp",
    "scala",
    "multi-language",
    "ast",
    "tiktoken",
    "optimizer",
    "gitingest",
    "real-time",
    "caching",
    "platform"
  ],
  "author": "Hakkı Sağdıç",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "@toon-format/toon": "^0.7.0",
    "@xenova/transformers": "^2.17.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "ink": "^6.4.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0",
    "zod": "^4.1.12"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "ctxman.js",
    "lib/",
    "bin/",
    ".ctxman/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "protobufjs": "^7.5.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.58.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "c8": "^10.1.3",
    "eslint": "^9.39.1",
    "lint-staged": "^17.3.0",
    "llama3-tokenizer-js": "^1.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "tiktoken": "^1.0.22",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "vue": "^3.5.24"
  }
}
